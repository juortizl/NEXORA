# Base de datos
# Desarrollo local sin Postgres (usar con `npm run db:local`):
DATABASE_URL="file:./dev.db"
# Producción (Render Postgres, se inyecta desde render.yaml):
# DATABASE_URL="postgresql://user:pass@host:5432/db"

# Auth.js
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_TRUST_HOST="true"

# Object storage (Cloudflare R2 / S3) para GLB, renders y PDFs
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# Usuarios iniciales del seed
SEED_ADMIN_EMAIL="admin@estructurar.co"
SEED_ADMIN_PASSWORD="Admin123*"
SEED_ADVISOR_PASSWORD="Asesor123*"
